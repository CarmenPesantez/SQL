SELECT ProductID, Quantity,
(SELECT ProductName FROM Products AS P
WHERE OD.ProductID=P.ProductID) AS Name
FROM OrderDetails AS OD

SELECT ProductID, Quantity,
(SELECT ProductName FROM [Products] P
WHERE OD.ProductID = P.ProductID) AS Name
FROM [OrderDetails] OD

(SELECT Price FROM Products [P]
WHERE P.ProductID = OD.ProductID) AS Price

SELECT ProductID, SUM(Quantity) AS Total_Vendido,
(SELECT Price FROM Products [P]
WHERE P.ProductID = OD.ProductID) AS Price,
(ROUND(SUM(Quantity) * (SELECT Price FROM Products [P]
WHERE P.ProductID = OD.ProductID),2)) AS Total_Recaudado
FROM OrderDetails [OD]
GROUP BY ProductID 
ORDER BY Total_Recaudado DESC

SELECT ProductID, SUM(Quantity) AS Total_Vendido,
(SELECT Price FROM Products [P]
WHERE P.ProductID = OD.ProductID) AS Price,
(SELECT ProductName FROM Products [P]
WHERE P.ProductID = OD.ProductID) AS Name,
(ROUND(SUM(Quantity) * (SELECT Price FROM Products [P]
WHERE P.ProductID = OD.ProductID),2)) AS Total_Recaudado
FROM OrderDetails [OD]
GROUP BY ProductID 
ORDER BY Total_Recaudado DESC

SELECT ProductID, SUM(Quantity) AS Total_Vendido,
(SELECT ProductName FROM [Products] P
WHERE P.ProductID = OD.ProductID) AS Name,
ROUND((SUM(Quantity)*(SELECT Price FROM [Products] P
WHERE P.ProductID=OD.ProductID))) AS Total_Recaudado
FROM [OrderDetails] OD
WHERE (SELECT Price FROM [Products] P WHERE P.ProductID = OD. ProductID) > 40
GROUP BY ProductID
ORDER BY Total_Recaudado


SELECT Name, Total_Vendido 
FROM (
SELECT ProductID, SUM(Quantity) AS Total_Vendido,
		(SELECT ProductName FROM [Products] P 
		WHERE P.ProductID = OD.ProductID) AS Name,
		ROUND((SELECT SUM(Quantity)*(SELECT Price FROM [Products] P 
		WHERE P.ProductID = OD.ProductID))) AS Total_Recaudado
FROM [OrderDetails] OD
WHERE (SELECT Price FROM [Products] P
		WHERE P.ProductID = OD.ProductID) > 40
GROUP BY ProductID
ORDER BY Total_Recaudado)

WHERE Total_Vendido >100
